<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layout principal para coordenar os componentes -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/cordinator_category_professionals"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/preto"> <!-- Container principal -->

        <!-- Barra de app com capacidade de colapsar -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_professional_profile"
            fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/verde"
            android:orientation="vertical"
            android:theme="@style/Theme.AppCompat">

            <!-- Toolbar que pode ser recolhida ao rolar a tela -->
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/toolbar_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/verde"
                android:fitsSystemWindows="true"
                app:contentScrim="?attr/colorPrimary"
                app:layout_scrollFlags="snap|scroll|exitUntilCollapsed">

                <!-- Layout com o logotipo e o nome do cabeçalho -->
                <RelativeLayout
                    android:id="@+id/logoname_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/verde"
                    android:gravity="top">

                    <!-- Logo (oculto por padrão) -->
                    <ImageView
                        android:id="@+id/header_professional_profile"
                        android:layout_width="60dp"
                        android:layout_height="match_parent"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="16dp"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/only_logo_white"
                        android:visibility="gone" />

                    <!-- Título do cabeçalho -->
                    <TextView
                        android:id="@+id/professional_name"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_centerHorizontal="true"
                        android:layout_margin="25dp"
                        android:gravity="center_vertical"
                        android:text="Componentes Curriculares"
                        android:textColor="@color/branco"
                        android:textSize="18dp" />

                    <!-- Campo de busca abaixo do título-->
                    <EditText
                        android:layout_width="match_parent"
                        android:id="@+id/editText"
                        android:layout_height="40dp"
                        android:layout_below="@+id/professional_name"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/branco"
                        android:drawableLeft="@drawable/ic_search_client"
                        android:drawablePadding="10dp"
                        android:hint="Cód. ou nome do cliente/empresa"
                        android:padding="10dp" />

                </RelativeLayout>


            </com.google.android.material.appbar.CollapsingToolbarLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Conteúdo que pode ser rolado -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/branco"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <!-- Layout contendo o RecyclerView -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- RecyclerView para exibir a lista de itens -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </RelativeLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Botão de ação flutuante no canto inferior direito -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/verde"
            android:src="@drawable/ic_add"
            app:srcCompat="@drawable/ic_add"
            app:tint="@color/branco" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Novo botão para abrir o campo de pesquisa -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"
        android:backgroundTint="@color/verde"
        android:src="@drawable/ic_search"
        app:tint="@color/branco"
    android:contentDescription="Pesquisar Disciplina" />


</RelativeLayout>
