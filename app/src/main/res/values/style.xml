<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RatingOutlinedCircle">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/outlined_circle_material3</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="RatingFilledCircle">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/filled_circle_material3</item>
        <item name="android:textColor">?attr/colorSurface</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>